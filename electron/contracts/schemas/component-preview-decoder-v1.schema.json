{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photoflow.local/schemas/component-preview-decoder-v1.schema.json",
  "title": "Preview decoder request/result contract",
  "type": "object", "additionalProperties": false, "required": ["request", "result"],
  "properties": {
    "request": {
      "type": "object", "additionalProperties": false, "required": ["input", "name", "extension", "pageIndex", "maxEdge"],
      "properties": {
        "input": { "type": "object", "additionalProperties": false, "required": ["token", "expiresAt"], "properties": { "token": { "type": "string", "minLength": 1, "maxLength": 128 }, "expiresAt": { "type": "integer", "minimum": 0 } } },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "extension": { "type": "string", "maxLength": 255 },
        "pageIndex": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "maxEdge": { "type": "integer", "minimum": 64, "maximum": 4096 }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false, "required": ["inputToken", "mimeType", "pageIndex", "pageCount"],
      "anyOf": [
        { "properties": { "mimeType": { "const": "image/png" }, "posterInputToken": false, "presentation": false } },
        { "properties": { "mimeType": { "enum": ["video/mp4", "video/quicktime"] }, "pageIndex": { "const": 0 }, "pageCount": { "const": 1 } } }
      ],
      "properties": {
        "inputToken": { "type": "string", "minLength": 1, "maxLength": 128 },
        "posterInputToken": { "type": "string", "minLength": 1, "maxLength": 128 },
        "presentation": { "const": "live-photo" },
        "mimeType": { "enum": ["image/png", "video/mp4", "video/quicktime"] },
        "pageIndex": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "pageCount": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    }
  }
}
